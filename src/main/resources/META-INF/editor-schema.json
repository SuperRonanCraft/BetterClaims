{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.ronanplugins.com/betterclaims/2",
  "title": "BetterClaims editor configuration",
  "type": "object",
  "properties": {
    "Claim": {
      "type": "object",
      "properties": {
        "MaxSize": {
          "type": "number"
        },
        "MaxDepth": {
          "type": "number"
        },
        "MaxClaims": {
          "type": "number"
        },
        "WorldsEnabled": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "Item": {
          "type": "string"
        }
      }
    },
    "Global": {
      "type": "object",
      "properties": {
        "EndermenMoveBlocks": {
          "type": "boolean"
        },
        "SilverfishBreakBlocks": {
          "type": "boolean"
        },
        "RabbitsEatCrops": {
          "type": "boolean"
        }
      }
    },
    "Player": {
      "type": "object",
      "properties": {
        "ProtectDeathDrops": {
          "type": "boolean"
        }
      }
    },
    "DefaultFlags": {
      "type": "object",
      "properties": {
        "PVP": {
          "type": "boolean",
          "default": false
        },
        "TNT": {
          "type": "boolean",
          "default": false
        },
        "ALLOW_DOOR": {
          "type": "boolean",
          "default": false
        },
        "ALLOW_LEVER": {
          "type": "boolean",
          "default": false
        },
        "ALLOW_BUTTON": {
          "type": "boolean",
          "default": false
        },
        "ALLOW_BED": {
          "type": "boolean",
          "default": false
        },
        "ALLOW_REQUESTS": {
          "type": "boolean",
          "default": true
        },
        "ALLOW_ITEM_PICKUP": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "x-editableProperties": true,
      "x-equivalentDefaults": true
    },
    "Language-File": {
      "type": "string",
      "description": "Change the language file locally."
    },
    "DateFormat": {
      "type": "string"
    },
    "DisableUpdater": {
      "type": "boolean"
    }
  },
  "x-bettersync": {
    "format": 1,
    "plugin": "betterclaims",
    "schemaVersion": "2",
    "displayName": "BetterClaims"
  },
  "required": [
    "Claim",
    "Global",
    "Player",
    "DefaultFlags"
  ]
}
